# Prefer Policies → AI settings to save settings without restarting.
# # Environment fallback: uncomment and supply a key locally. Never commit it.
# OPENROUTER_API_KEY=your-openrouter-api-key
# # Optional per-task overrides; budget defaults are also selectable in the UI.
# AI_EXTRACTION_MODEL=mistralai/mistral-nemo
# AI_VISION_MODEL=google/gemma-3-12b-it
# AI_MATCHING_MODEL=mistralai/mistral-small-24b-instruct-2501
# AI_POLICY_MODEL=mistralai/mistral-small-24b-instruct-2501
# AI_REVIEW_MODEL=mistralai/mistral-nemo
# # Legacy compatible-provider configuration is still supported:
# # AI_BASE_URL=http://127.0.0.1:11434/v1
# # AI_MODEL=your-installed-model
# # AI_API_KEY=your-key-if-needed

# AP_TIMEZONE=Asia/Kolkata
