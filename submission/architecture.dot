digraph APReview {
  graph [rankdir=TB, bgcolor="transparent", pad="0.06", nodesep="0.22", ranksep="0.20", splines=ortho, size="6.7,4.8!", dpi=96];
  node [shape=box, style="rounded,filled", color="#cbd5e1", fillcolor="#f8fafc", fontname="DejaVu Sans", fontsize=10, margin="0.12,0.09"];
  edge [color="#64748b", arrowsize=0.6, penwidth=1.2];
  invoice [label="Invoice PDF\nor image"];
  reading [label="Text/OCR +\nOpenRouter vision", fillcolor="#e0f2fe"];
  facts [label="Source-backed\ninvoice facts"];
  rules [label="Exact checks\namounts + PO capacity", fillcolor="#dcfce7"];
  result [label="Recommendation\nwith evidence"];
  reviewer [label="Human verifies\nand decides", fillcolor="#fef3c7"];
  po [label="PO PDF/image\nreviewed by human", fillcolor="#fef3c7"];
  refs [label="Vendor master\nhistory + policy"];
  {rank=same; invoice; po; refs;}
  invoice -> reading -> facts -> rules -> result -> reviewer;
  po -> rules;
  refs -> rules;
}
